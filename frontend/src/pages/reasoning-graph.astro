---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReasoningGraph from '../components/graph/ReasoningGraph';

const sid = Astro.url.searchParams.get('sid') ?? '';
---
<BaseLayout title="Reasoning Graph">
  <h1 class="serif-q mb-4 text-3xl text-amber">Reasoning Graph</h1>
  <p class="mb-4 text-sm opacity-80">
    Claims become nodes, logical steps become edges. Click a node to read the
    original statement. A plain list follows the graph for small screens.
  </p>
  <ReasoningGraph client:visible initialSid={sid} />
</BaseLayout>

---
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/session", "label": "Session"}, {"href": "/reasoning-graph", "label": "Graph"}, {"href": "/profile", "label": "Profile"}, {"href": "/settings", "label": "Settings"}];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand">
      <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
      <span>Socratic Debate</span>
    </a>
    <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href === '/' ? base || '/' : `${base}${l.href}`}
              data-navlink={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li class="hidden md:ml-2 md:inline-flex">
          <a href={`${base}/session`} class="nav-link nav-cta">Start debating</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
